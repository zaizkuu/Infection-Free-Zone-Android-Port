{
  "name": "ember-haven",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "Ember Haven - a zombie-outbreak survival strategy game for Android.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/screen-orientation": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
